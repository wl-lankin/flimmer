{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flimmer",
  "version": "0.1.0",
  "identifier": "de.wolfganglinz.flimmer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flimmer",
        "width": 1200,
        "height": 720,
        "minWidth": 480,
        "minHeight": 300,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#00000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1461",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Wolfgang Linz",
    "copyright": "Copyright 2026 Wolfgang Linz",
    "homepage": "https://wolfgang-linz.de",
    "category": "Video",
    "shortDescription": "A video player that plays everything.",
    "longDescription": "Flimmer plays every video format there is, on Windows and macOS."
  }
}
